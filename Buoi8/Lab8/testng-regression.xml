<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo_Regression_Suite" verbose="1">
    <parameter name="baseUrl" value="https://www.saucedemo.com/"/>

    <groups>
        <run>
            <include name="regression"/>
        </run>
    </groups>

    <test name="Regression Tests">
        <classes>
            <class name="org.example.bai2.LoginTestBai2"/>
            <class name="org.example.bai2.CartTest"/>
            <class name="org.example.bai2.CheckoutTest"/>
        </classes>
    </test>
</suite>